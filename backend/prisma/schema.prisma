datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Reading {
  id             Int      @id @default(autoincrement())
  timestamp      DateTime @default(now())
  profile        String
  rawPayload     String   // Full JSON payload for future reference
  heartRate      Float
  spo2           Float
  temperature    Float
  activityScore  Float
  contactQuality Float
}

model Prediction {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  profile     String   // simulator profile active (healthy/ckd-risk)
  egfr        Float
  ckdStage    String
  riskLevel   String
  confidence  Float
  explanation String
  age         Int
  gender      String
  bmi         Float
  sbp         Float
  dbp         Float
}
